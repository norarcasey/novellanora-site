# Supabase — same project as the journal-app studio.
# These are read by the Astro server. RLS guarantees the anon key
# can only see published_entries.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Shared secret with the studio. The studio sends this in the body
# of POST /api/revalidate; we reject any request whose secret doesn't match.
REVALIDATE_SECRET=generate-a-long-random-string

# Vercel ISR bypass token. Set the same value in Vercel project settings
# (or let Vercel generate one and copy it here).
REVALIDATE_BYPASS_TOKEN=another-long-random-string

# The deployed site URL. Used by /api/revalidate to fetch routes
# with the bypass token. Leave unset locally; set to https://novellanora.com
# in Vercel production env.
SITE_URL=http://localhost:4321
